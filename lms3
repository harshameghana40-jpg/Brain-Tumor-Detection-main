import { Server as SocketIOServer } from "socket.io";

const roomMessages = new Map(); // roomId -> array of message objects

export function initializeSocketServer(httpServer, frontendOrigin) {
  const io = new SocketIOServer(httpServer, {
    cors: {
      origin: "*",
      methods: ["GET", "POST"]
    }
  });

  io.on("connection", (socket) => {
    console.log(`[Socket.io] Client connected: ${socket.id}`);

    // Join user-specific socket room for global popup notifications (e.g. user_UID)
    socket.on("register_user", ({ uid, role }) => {
      if (uid) {
        socket.join(`user_${uid}`);
        console.log(`[Socket.io] User ${uid} (${role}) registered global socket channel user_${uid}`);
      }
    });

    // Join private meeting room
    socket.on("join_room", ({ roomId, userId, userName, role }) => {
      if (!roomId) return;
      socket.join(roomId);
      socket.data = { roomId, userId, userName, role };

      console.log(`[Socket.io] ${userName} (${role}) joined room: ${roomId}`);

      // Send existing chat history for this room
      const existingMsgs = roomMessages.get(roomId) || [];
      socket.emit("room_chat_history", existingMsgs);

      // Notify existing room members
      socket.to(roomId).emit("user_joined", {
        socketId: socket.id,
        userId,
        userName,
        role
      });
    });

    // WebRTC Signaling
    socket.on("webrtc_offer", ({ roomId, offer }) => {
      socket.to(roomId).emit("webrtc_offer", {
        senderSocketId: socket.id,
        senderId: socket.data?.userId,
        senderName: socket.data?.userName,
        offer
      });
    });

    socket.on("webrtc_answer", ({ roomId, answer }) => {
      socket.to(roomId).emit("webrtc_answer", {
        senderSocketId: socket.id,
        answer
      });
    });

    socket.on("webrtc_ice_candidate", ({ roomId, candidate }) => {
      socket.to(roomId).emit("webrtc_ice_candidate", {
        senderSocketId: socket.id,
        candidate
      });
    });

    // Real-time 1-on-1 Direct Messaging between Faculty & Student
    socket.on("send_private_message", (msgObj) => {
      const { recipientUid, senderUid } = msgObj;
      console.log(`[Socket.io] Direct 1-on-1 message from ${senderUid} to ${recipientUid}`);
      if (recipientUid) {
        io.in(`user_${recipientUid}`).emit("receive_private_message", msgObj);
      }
      if (senderUid) {
        io.in(`user_${senderUid}`).emit("receive_private_message", msgObj);
      }
    });

    // Private Messaging in Room
    socket.on("send_chat_message", ({ roomId, senderId, senderName, senderRole, message }) => {
      if (!roomId || !message?.trim()) return;

      const chatObj = {
        id: `msg_${Date.now()}_${Math.random().toString(36).substr(2, 5)}`,
        senderId,
        senderName,
        senderRole,
        message: message.trim(),
        timestamp: new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })
      };

      if (!roomMessages.has(roomId)) {
        roomMessages.set(roomId, []);
      }
      const msgs = roomMessages.get(roomId);
      msgs.push(chatObj);
      if (msgs.length > 200) msgs.shift(); // Keep last 200 messages

      io.in(roomId).emit("receive_chat_message", chatObj);
    });

    // Student Raise Hand
    socket.on("student_raise_hand", ({ roomId, studentUid, studentName, facultyUid }) => {
      console.log(`[Socket.io] Student ${studentName} raised hand in room ${roomId}`);

      // 1. Broadcast hand_raised inside meeting room
      io.in(roomId).emit("hand_raised", {
        studentUid,
        studentName,
        timestamp: new Date().toLocaleTimeString()
      });

      // 2. Also send real-time popup notification directly to Faculty's global user channel
      if (facultyUid) {
        io.in(`user_${facultyUid}`).emit("faculty_popup_notification", {
          type: "raise_hand",
          studentUid,
          studentName,
          roomId,
          message: `✋ Student ${studentName} raised their hand in the 1-on-1 private session!`,
          timestamp: new Date().toLocaleTimeString()
        });
      }
    });

    // Lower Hand
    socket.on("lower_hand", ({ roomId, studentUid }) => {
      io.in(roomId).emit("hand_lowered", { studentUid });
    });

    // Leave Room / Disconnect
    socket.on("leave_room", ({ roomId }) => {
      if (roomId) {
        socket.leave(roomId);
        socket.to(roomId).emit("user_left", {
          socketId: socket.id,
          userId: socket.data?.userId,
          userName: socket.data?.userName
        });
      }
    });

    socket.on("disconnect", () => {
      if (socket.data?.roomId) {
        socket.to(socket.data.roomId).emit("user_left", {
          socketId: socket.id,
          userId: socket.data?.userId,
          userName: socket.data?.userName
        });
      }
      console.log(`[Socket.io] Client disconnected: ${socket.id}`);
    });
  });

  return io;
}

