              </svg>
              <span>My Assignments</span>
              <span className="faculty-nav-badge">{myAssignments.length}</span>
            </button>

            <button
              type="button"
              className={`faculty-nav-item ${activeTab === "submissions" ? "active" : ""}`}
              onClick={() => {
                setActiveTab("submissions");
                setIsMobileSidebarOpen(false);
              }}
              id="tab-review-submissions"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2">
