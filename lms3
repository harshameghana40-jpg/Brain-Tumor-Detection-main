import { useState, useEffect, useRef, useCallback } from "react";
import { useAuth } from "../context/useAuth";
import logo from "../assets/logo.png";
import MeetingRoom from "../components/MeetingRoom";
import { io } from "socket.io-client";
import {
    getAssignments,
    submitWork,
    getMySubmissions,
    createPaymentOrder,
    verifyPayment,
    getMyCertificates,
    getConversationHistory,
    sendPrivateMessage
} from "../api/client";
import "../styles/Dashboard.css";

const loadRazorpayScript = () => {
    return new Promise((resolve) => {
        if (window.Razorpay) {
            return resolve(true);
        }
        const script = document.createElement("script");
        script.src = "https://checkout.razorpay.com/v1/checkout.js";
        script.async = true;
        script.onload = () => resolve(true);
        script.onerror = () => resolve(false);
        document.body.appendChild(script);
    });
};

function Dashboard({ onLogout }) {
    const { currentUser, userRole, profile, logout } = useAuth();
    const [assignments, setAssignments] = useState([]);
    const [mySubmissions, setMySubmissions] = useState([]);
    const [certificates, setCertificates] = useState([]);
    const [selectedCertForView, setSelectedCertForView] = useState(null);
    const [searchTerm, setSearchTerm] = useState("");
    const [filterSubject, setFilterSubject] = useState("all");
    const [activeNavTab, setActiveNavTab] = useState("dashboard"); // "dashboard" | "assigned" | "submissions" | "certifications"
    const [isMobileSidebarOpen, setIsMobileSidebarOpen] = useState(false);
    const [isLoading, setIsLoading] = useState(true);

    // Modals state
    const [selectedAssignmentForView, setSelectedAssignmentForView] = useState(null);
    const [selectedAssignmentForSubmit, setSelectedAssignmentForSubmit] = useState(null);

    // Submit Modal Form State
    const [submissionFile, setSubmissionFile] = useState(null); // { name, size, type, dataUrl }
    const submissionFileInputRef = useRef(null);
    const [submissionNotes, setSubmissionNotes] = useState("");
    const [isSubmittingWork, setIsSubmittingWork] = useState(false);
    const [toastMsg, setToastMsg] = useState({ type: "", text: "" });

    // Payment Gateway State (Razorpay Test Mode)
    const [isPaymentProcessing, setIsPaymentProcessing] = useState(false);
    const [paymentReceipt, setPaymentReceipt] = useState(null);
    const [showTestPaymentModal, setShowTestPaymentModal] = useState(null);

    // Active Meeting State
    const [activeMeeting, setActiveMeeting] = useState(null); // { roomId, peerName, peerRole }

    // Persistent 1-on-1 Messaging State
    const [chatMessages, setChatMessages] = useState([]);
    const [chatInputText, setChatInputText] = useState("");
    const [isLoadingChat, setIsLoadingChat] = useState(false);
    const [isSendingChat, setIsSendingChat] = useState(false);
    const chatBottomRef = useRef(null);

    // Fetch live assignments and submissions exclusively from MongoDB API
    const loadData = useCallback(async () => {
        if (!currentUser) return;
        setIsLoading(true);
        try {
            const apiAssignments = await getAssignments(currentUser);
            if (Array.isArray(apiAssignments)) {
                setAssignments(apiAssignments);
            } else {
                setAssignments([]);
            }
        } catch (err) {
            console.warn("Could not fetch assignments from API:", err.message);
            setAssignments([]);
        } finally {
            setIsLoading(false);
        }

        try {
            const subs = await getMySubmissions(currentUser);
            if (Array.isArray(subs)) {
                setMySubmissions(subs);
            }
        } catch {
            setMySubmissions([]);
        }

        try {
            const certs = await getMyCertificates(currentUser);
            if (Array.isArray(certs)) {
                setCertificates(certs);
            }
        } catch {
            setCertificates([]);
        }
    }, [currentUser]);

    useEffect(() => {
        // eslint-disable-next-line react-hooks/set-state-in-effect
        loadData();
    }, [loadData]);

    const handleSignOut = async () => {
        await logout();
        if (onLogout) {
            onLogout();
        }
    };

    // Load persistent chat history with allocated faculty
    const loadStudentChatHistory = useCallback(async () => {
        if (!currentUser || !profile?.allocatedFacultyId) return;
        setIsLoadingChat(true);
        try {
            const msgs = await getConversationHistory(currentUser, profile.allocatedFacultyId);
            setChatMessages(Array.isArray(msgs) ? msgs : []);
        } catch (err) {
            console.warn("Could not load chat history:", err.message);
        } finally {
            setIsLoadingChat(false);
        }
    }, [currentUser, profile?.allocatedFacultyId]);

    useEffect(() => {
        if (activeNavTab === "interaction" && profile?.allocatedFacultyId) {
            loadStudentChatHistory();
        }
    }, [activeNavTab, profile?.allocatedFacultyId, loadStudentChatHistory]);

    // Real-time socket listener for incoming messages
    useEffect(() => {
        if (!currentUser) return;
        const uid = currentUser.firebaseUid || currentUser.uid;
        const serverUrl = window.location.hostname === "localhost" ? "http://localhost:4000" : "/";
        const socket = io(serverUrl);
        socket.emit("register_user", { uid, role: "student" });

        socket.on("receive_private_message", (newMsg) => {
            setChatMessages((prev) => {
                if (prev.some((m) => (m._id && m._id === newMsg._id) || (m.createdAt && m.createdAt === newMsg.createdAt && m.message === newMsg.message))) {
                    return prev;
                }
                return [...prev, newMsg];
            });
        });

        return () => socket.disconnect();
    }, [currentUser]);

    // Scroll to bottom of chat
    useEffect(() => {
        if (chatMessages.length > 0) {
            chatBottomRef.current?.scrollIntoView({ behavior: "smooth" });
        }
    }, [chatMessages]);

    const handleSendStudentMessage = async (e) => {
        e.preventDefault();
        if (!chatInputText.trim() || !profile?.allocatedFacultyId || !currentUser) return;
        setIsSendingChat(true);
        try {
            const sentMsg = await sendPrivateMessage(
                currentUser,
                profile.allocatedFacultyId,
                chatInputText.trim(),
                "student"
            );
            setChatMessages((prev) => [...prev, sentMsg]);
            setChatInputText("");

            const serverUrl = window.location.hostname === "localhost" ? "http://localhost:4000" : "/";
            const socket = io(serverUrl);
            socket.emit("send_private_message", sentMsg);
            setTimeout(() => socket.disconnect(), 1000);
        } catch (err) {
            setToastMsg({ type: "error", text: err.message || "Could not send message" });
        } finally {
            setIsSendingChat(false);
        }
    };

    // Quick Raise Hand alert from dashboard view
    const handleStudentRaiseHandFromDashboard = () => {
        if (!profile?.allocatedFacultyId) {
            setToastMsg({ type: "warning", text: "Faculty mentor is not allocated yet." });
            return;
        }
        const serverUrl = window.location.hostname === "localhost" ? "http://localhost:4000" : "/";
        const socket = io(serverUrl);
        const studentUid = currentUser?.firebaseUid || currentUser?.uid;
        const studentName = currentUser?.displayName || currentUser?.name || currentUser?.email?.split("@")[0] || "Student";
        const roomId = `room_${profile.allocatedFacultyId}_${studentUid}`;

        socket.emit("student_raise_hand", {
            roomId,
            studentUid,
            studentName,
            facultyUid: profile.allocatedFacultyId
        });

        setToastMsg({
            type: "success",
            text: "✋ Hand raised! A real-time popup notification has been sent to your Faculty Mentor."
        });

        setTimeout(() => socket.disconnect(), 2000);
    };

    // -------------------------------------------------------------
    // RAZORPAY PAYMENT (TEST MODE) HANDLERS
    // -------------------------------------------------------------
    const handleOpenPayment = async () => {
        if (!currentUser) return;
        setIsPaymentProcessing(true);
        setToastMsg({ type: "info", text: "Opening Razorpay Test Payment..." });

        try {
            const orderData = await createPaymentOrder(currentUser, 500);

            // Check if user provided a registered live test key (e.g. rzp_test_...)
            const activeKey = orderData.keyId || import.meta.env.VITE_RAZORPAY_KEY_ID;
            const isLiveKey =
                activeKey &&
                !activeKey.includes("placeholder") &&
                activeKey.startsWith("rzp_test_") &&
                activeKey.length >= 20;

            if (!isLiveKey) {
                setShowTestPaymentModal({
                    open: true,
                    orderData,
                    testMethod: "card",
                });
                setIsPaymentProcessing(false);
                return;
            }

            const scriptLoaded = await loadRazorpayScript();
            if (!scriptLoaded || !window.Razorpay) {
                setShowTestPaymentModal({
                    open: true,
                    orderData,
                    testMethod: "card",
                });
                setIsPaymentProcessing(false);
                return;
            }

            const options = {
                key: activeKey,
                amount: orderData.amount,
                currency: orderData.currency || "INR",
                name: "V2V LMS",
                description: "Student Course & Services Fee (Test Mode)",
                image: logo,
                order_id:
                    orderData.orderId && !orderData.orderId.startsWith("order_test_")
                        ? orderData.orderId
                        : undefined,
                handler: async function (response) {
                    try {
                        setIsPaymentProcessing(true);
                        await verifyPayment(currentUser, {
                            razorpay_order_id: response.razorpay_order_id || orderData.orderId,
                            razorpay_payment_id: response.razorpay_payment_id,
                            razorpay_signature: response.razorpay_signature,
                            amount: 500,
                        });

                        setPaymentReceipt({
                            status: "success",
                            paymentId: response.razorpay_payment_id,
                            orderId: response.razorpay_order_id || orderData.orderId,
                            amount: 500,
                            date: new Date().toLocaleString(),
                            message: "Payment successfully verified! (Test Mode)",
                        });
                        setToastMsg({ type: "success", text: "Payment completed & verified successfully!" });
                    } catch (err) {
                        setPaymentReceipt({
                            status: "error",
                            message: err.message || "Payment verification failed",
                        });
                        setToastMsg({ type: "error", text: "Payment verification failed." });
                    } finally {
                        setIsPaymentProcessing(false);
                    }
                },
                prefill: {
                    name: currentUser?.displayName || currentUser?.email?.split("@")[0] || "Student",
                    email: currentUser?.email || "student@v2v.edu",
                    contact: "9999999999",
                },
                notes: {
                    portal: "Student Dashboard",
                    purpose: "LMS Course Fee (Test Mode)",
                },
                theme: {
                    color: "#7B2FFF",
                },
                modal: {
                    ondismiss: function () {
                        setIsPaymentProcessing(false);
                        setToastMsg({ type: "warning", text: "Payment checkout was cancelled." });
                    },
                },
            };

            try {
                const razorpayInstance = new window.Razorpay(options);
                razorpayInstance.on("payment.failed", function (response) {
                    setIsPaymentProcessing(false);
                    setPaymentReceipt({
                        status: "error",
                        message: response.error?.description || "Payment transaction failed.",
                        code: response.error?.code,
                    });
                    setToastMsg({ type: "error", text: `Payment failed: ${response.error?.description || "Error"}` });
                });
                razorpayInstance.open();
            } catch (rzpErr) {
                console.warn("Direct Razorpay modal open warning:", rzpErr);
                setShowTestPaymentModal({
                    open: true,
                    orderData,
                    testMethod: "card",
                });
                setIsPaymentProcessing(false);
            }
        } catch (err) {
            setIsPaymentProcessing(false);
            setToastMsg({ type: "error", text: err.message || "Unable to initiate payment" });
        }
    };

    const handleCompleteSimulatedTestPayment = async (orderData) => {
        if (!currentUser) return;
        setIsPaymentProcessing(true);
        setShowTestPaymentModal(null);
        try {
            const mockPaymentId = `pay_test_${Date.now()}`;
            await verifyPayment(currentUser, {
                razorpay_order_id: orderData.orderId,
                razorpay_payment_id: mockPaymentId,
                razorpay_signature: "mock_test_signature",
                amount: 500,
            });

            setPaymentReceipt({
                status: "success",
                paymentId: mockPaymentId,
                orderId: orderData.orderId,
                amount: 500,
                date: new Date().toLocaleString(),
                message: "Payment successfully verified! (Test Mode)",
            });
            setToastMsg({ type: "success", text: "Payment completed & verified successfully in Test Mode!" });
        } catch (err) {
            setPaymentReceipt({
                status: "error",
                message: err.message || "Payment verification failed",
            });
            setToastMsg({ type: "error", text: "Payment verification failed." });
        } finally {
            setIsPaymentProcessing(false);
        }
    };

    const handleFailSimulatedTestPayment = () => {
        setShowTestPaymentModal(null);
        setPaymentReceipt({
            status: "error",
            message: "Payment failed: Transaction declined by bank in Test Mode.",
            code: "SIMULATED_DECLINE",
        });
        setToastMsg({ type: "error", text: "Payment failed: Transaction declined." });
    };

    // Download Assignment Attachment
    const handleExecuteDownload = (assignment) => {
        if (assignment.fileUrl && assignment.fileUrl.startsWith("data:")) {
            const element = document.createElement("a");
            element.href = assignment.fileUrl;
            element.download = assignment.attachedFileName || "assignment_resource.pdf";
            document.body.appendChild(element);
            element.click();
            document.body.removeChild(element);
        } else {
            const element = document.createElement("a");
            const fileContent = `V2V LMS - Assignment Resource\n=================================\nAssignment: ${assignment.title}\nFaculty: ${assignment.facultyName}\nAssigned: ${assignment.assignedTimestamp || (assignment.createdAt ? new Date(assignment.createdAt).toLocaleDateString() : "N/A")}\nDue: ${assignment.dueDate} at ${assignment.dueTime}\nAttached File: ${assignment.attachedFileName || "None"}\n\nDescription:\n${assignment.description}`;
            const file = new Blob([fileContent], { type: "text/plain" });
            element.href = URL.createObjectURL(file);
            element.download = (assignment.attachedFileName || "assignment_details.txt").replace(/\.(pdf|zip|pcapng)$/i, ".txt");
            document.body.appendChild(element);
            element.click();
            document.body.removeChild(element);
        }

        setToastMsg({ type: "success", text: `Downloaded "${assignment.attachedFileName || assignment.title}" resource file.` });
        setTimeout(() => setToastMsg({ type: "", text: "" }), 4000);
    };

    // File selection for submission
    const handleSubmissionFileChange = (e) => {
        const file = e.target.files?.[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = () => {
            setSubmissionFile({
                name: file.name,
                size: (file.size / (1024 * 1024)).toFixed(2) + " MB",
                type: file.type || "application/octet-stream",
                dataUrl: reader.result
            });
        };
        reader.readAsDataURL(file);
        e.target.value = "";
    };

    // Submit Student Work to Backend
    const handleExecuteSubmitWork = async (e) => {
        e.preventDefault();
        if (!submissionFile) {
            setToastMsg({ type: "error", text: "Please upload your submission file." });
            return;
        }

        setIsSubmittingWork(true);

        const asgId = selectedAssignmentForSubmit._id || selectedAssignmentForSubmit.id;

        const submissionPayload = {
            assignmentId: asgId,
            assignmentTitle: selectedAssignmentForSubmit.title,
            fileName: submissionFile.name,
            fileType: submissionFile.type,
            fileSize: submissionFile.size,
            fileUrl: submissionFile.dataUrl,
            notes: submissionNotes.trim()
        };

        try {
            const response = await submitWork(currentUser, submissionPayload);
            const savedSub = response.submission;
            if (!savedSub) {
                throw new Error("The server did not return the saved submission.");
            }

            setMySubmissions((prev) => {
                const filtered = prev.filter((s) => s.assignmentId !== asgId);
                return [savedSub, ...filtered];
            });

            setToastMsg({ type: "success", text: `Your work for "${selectedAssignmentForSubmit.title}" was submitted successfully!` });
            setSelectedAssignmentForSubmit(null);
            setSubmissionFile(null);
            setSubmissionNotes("");
            setTimeout(() => setToastMsg({ type: "", text: "" }), 5000);
        } catch (err) {
            setToastMsg({ type: "error", text: err.message || "Failed to submit work." });
        } finally {
            setIsSubmittingWork(false);
        }
    };

    // Helper to check if current student submitted work for an assignment
    const getSubmissionForAssignment = (asgId) => {
        return mySubmissions.find((s) => s.assignmentId === asgId);
    };

    // Derive unique subjects from real assignments
    const uniqueSubjects = Array.from(
        new Set(
            assignments
                .map((item) => item.subject?.trim())
                .filter((subj) => Boolean(subj))
        )
    );

    // Filtered assignments
    const filteredAssignments = assignments.filter((item) => {
        const asgId = item._id || item.id;
        const isSubmitted = Boolean(getSubmissionForAssignment(asgId));

        if (activeNavTab === "submissions" && !isSubmitted) {
            return false;
        }

        const matchesSearch =
            item.title?.toLowerCase().includes(searchTerm.toLowerCase()) ||
            item.description?.toLowerCase().includes(searchTerm.toLowerCase()) ||
            (item.facultyName && item.facultyName.toLowerCase().includes(searchTerm.toLowerCase())) ||
            (item.attachedFileName && item.attachedFileName.toLowerCase().includes(searchTerm.toLowerCase()));

        const matchesSubject =
            filterSubject === "all" || item.subject?.trim().toLowerCase() === filterSubject.toLowerCase();

        return matchesSearch && matchesSubject;
    });

    const pendingWorksCount = Math.max(0, assignments.length - mySubmissions.length);

    return (
        <div className="lms-app-layout">
            {/* -------------------------------------------------------------
          SIDEBAR NAVIGATION
      ------------------------------------------------------------- */}
            <aside className={`lms-sidebar ${isMobileSidebarOpen ? "open" : ""}`} aria-label="Student Navigation">
                <div>
                    <div className="sidebar-header">
                        <a href="#dashboard" className="sidebar-brand-link" onClick={() => setActiveNavTab("dashboard")}>
                            <img src={logo} alt="V2V Tech Logo" className="sidebar-brand-logo" />
                            <div className="sidebar-brand-text">
                                <span className="sidebar-brand-title">V2V LMS</span>
                                <span className="sidebar-brand-sub">Student Portal</span>
                            </div>
                        </a>
                    </div>

                    <nav className="sidebar-nav-list">
                        <div className="sidebar-nav-section-title">Navigation</div>

                        <button
                            type="button"
                            className={`sidebar-nav-item ${activeNavTab === "dashboard" ? "active" : ""}`}
                            onClick={() => {
                                setActiveNavTab("dashboard");
                                setIsMobileSidebarOpen(false);
                            }}
                        >
                            <span className="sidebar-nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2">
                                    <rect x="3" y="3" width="7" height="7" rx="1.5" />
                                    <rect x="14" y="3" width="7" height="7" rx="1.5" />
                                    <rect x="14" y="14" width="7" height="7" rx="1.5" />
                                    <rect x="3" y="14" width="7" height="7" rx="1.5" />
                                </svg>
                            </span>
                            <span>Dashboard</span>
                        </button>

                        <button
                            type="button"
                            className={`sidebar-nav-item ${activeNavTab === "assigned" ? "active" : ""}`}
                            onClick={() => {
                                setActiveNavTab("assigned");
                                setIsMobileSidebarOpen(false);
                            }}
                        >
                            <span className="sidebar-nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                    <polyline points="14 2 14 8 20 8" />
                                    <line x1="16" y1="13" x2="8" y2="13" />
                                    <line x1="16" y1="17" x2="8" y2="17" />
                                </svg>
                            </span>
                            <span>Assigned Works</span>
                            <span className="sidebar-nav-badge">{assignments.length}</span>
                        </button>

                        <button
                            type="button"
                            className={`sidebar-nav-item ${activeNavTab === "submissions" ? "active" : ""}`}
                            onClick={() => {
                                setActiveNavTab("submissions");
                                setIsMobileSidebarOpen(false);
                            }}
                        >
                            <span className="sidebar-nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2">
                                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                                    <polyline points="22 4 12 14.01 9 11.01" />
                                </svg>
                            </span>
                            <span>My Submissions</span>
                            <span className="sidebar-nav-badge cyan">{mySubmissions.length}</span>
                        </button>

                        <button
                            type="button"
                            className={`sidebar-nav-item ${activeNavTab === "certifications" ? "active" : ""}`}
                            onClick={() => {
                                setActiveNavTab("certifications");
                                setIsMobileSidebarOpen(false);
                            }}
                        >
                            <span className="sidebar-nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2">
                                    <path d="M12 15l-2 5l5-3l5 3l-2-5" />
                                    <circle cx="12" cy="9" r="6" />
                                </svg>
                            </span>
                            <span>Certifications</span>
                            {certificates.length > 0 && <span className="sidebar-nav-badge gold">{certificates.length}</span>}
                        </button>

                        <button
                            type="button"
                            className={`sidebar-nav-item ${activeNavTab === "interaction" ? "active" : ""}`}
                            onClick={() => {
                                setActiveNavTab("interaction");
                                setIsMobileSidebarOpen(false);
                            }}
                        >
                            <span className="sidebar-nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2">
                                    <path d="M15 10l5 5-5 5" />
                                    <path d="M4 4v7a4 4 0 0 0 4 4h12" />
                                </svg>
                            </span>
                            <span>1-on-1 Interaction</span>
                            {profile?.allocationStatus === "Assigned" && (
                                <span className="sidebar-nav-badge cyan">Live</span>
                            )}
                        </button>

                        <div className="sidebar-nav-section-title" style={{ marginTop: "14px" }}>Services</div>

                        <button
                            type="button"
                            className="sidebar-nav-item"
                            onClick={() => {
                                setIsMobileSidebarOpen(false);
                                handleOpenPayment();
                            }}
                        >
                            <span className="sidebar-nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2">
                                    <rect x="1" y="4" width="22" height="16" rx="2" ry="2" />
                                    <line x1="1" y1="10" x2="23" y2="10" />
                                </svg>
                            </span>
                            <span>Fee Payment</span>
                        </button>
                    </nav>
                </div>

                <div className="sidebar-footer">
                    <div>V2V Tech &copy; {new Date().getFullYear()}</div>
                    <div style={{ fontSize: "0.7rem", color: "rgba(255,255,255,0.35)" }}>LMS Version 2.0</div>
                </div>
            </aside>

            {/* -------------------------------------------------------------
          MAIN APP CANVAS
      ------------------------------------------------------------- */}
            <div className="lms-main-wrapper">
                {/* Topbar */}
                <header className="lms-topbar">
                    <div className="topbar-left">
                        <button
                            type="button"
                            className="btn-sidebar-toggle"
                            onClick={() => setIsMobileSidebarOpen(!isMobileSidebarOpen)}
                            aria-label="Toggle navigation menu"
                        >
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5">
                                <line x1="3" y1="12" x2="21" y2="12" />
                                <line x1="3" y1="6" x2="21" y2="6" />
                                <line x1="3" y1="18" x2="21" y2="18" />
                            </svg>
                        </button>

                        <div className="topbar-page-context">
                            <span className="topbar-page-title">
                                {activeNavTab === "submissions"
                                    ? "My Submissions"
                                    : activeNavTab === "assigned"
                                        ? "Assigned Coursework"
                                        : activeNavTab === "certifications"
                                            ? "Certifications"
                                            : activeNavTab === "interaction"
                                                ? "1-on-1 Faculty Interaction"
                                                : "Student Learning Dashboard"}
                            </span>
                            <span className="topbar-page-subtitle">
                                Academic Year {new Date().getFullYear()}
                            </span>
                        </div>
                    </div>

                    <div className="topbar-actions">
                        {/* Payment CTA */}
                        <button
                            type="button"
                            className="btn-topbar-payment"
                            onClick={handleOpenPayment}
                            disabled={isPaymentProcessing}
                            id="dashboard-payment-btn"
                            title="Make Fee Payment (Test Mode)"
                        >
