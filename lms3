                        {/* Remote Name Badge Overlay */}
                        <div
                            style={{
                                position: "absolute",
                                bottom: "16px",
                                left: "16px",
                                backgroundColor: "rgba(15, 23, 42, 0.8)",
                                backdropFilter: "blur(8px)",
