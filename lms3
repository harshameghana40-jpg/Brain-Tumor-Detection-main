          <div>V2V Tech &copy; {new Date().getFullYear()}</div>
          <div style={{ fontSize: "0.7rem", color: "rgba(255,255,255,0.35)" }}>Faculty Academic Suite</div>
        </div>
      </aside>

      {/* -------------------------------------------------------------
          MAIN FACULTY WORKSPACE
      ------------------------------------------------------------- */}
