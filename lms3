                        {toastMsg.type === "success" && "✅"}
                        {toastMsg.type === "error" && "❌"}
                        {toastMsg.type === "warning" && "⚠️"}
                        {toastMsg.type === "info" && "ℹ️"}
                    </span>
                    <span>{toastMsg.text}</span>
                    <button
                        type="button"
                        onClick={() => setToastMsg({ type: "", text: "" })}
                        style={{ background: "none", border: "none", color: "inherit", cursor: "pointer", marginLeft: "8px" }}
                    >
                        ✕
                    </button>
                </div>
            )}
            {/* ACTIVE 1-ON-1 MEETING ROOM OVERLAY */}
            {activeMeeting && (
                <MeetingRoom
                    roomId={activeMeeting.roomId}
                    currentUser={currentUser}
                    userRole="student"
                    peerName={activeMeeting.peerName}
                    peerRole={activeMeeting.peerRole}
                    onCloseMeeting={() => setActiveMeeting(null)}
                />
            )}
        </div>
    );
}

export default Dashboard;

import { useState, useEffect, useCallback } from "react";
import { useAuth } from "../context/useAuth";
import logo from "../assets/logo.png";
import { io } from "socket.io-client";
import MeetingRoom from "../components/MeetingRoom";
import RaiseHandToast from "../components/RaiseHandToast";
import {
  createAssignment,
  getMyFacultyAssignments,
  deleteAssignment,
  getAssignmentSubmissions,
  getRegisteredStudents,
  allocateStudent,
  getFacultyCertificates,
  issueCertificate,
  getConversationHistory,
  sendPrivateMessage
} from "../api/client";
import "../styles/Faculty.css";

function FacultyPage({ onLogout }) {
  const { currentUser, userRole, logout } = useAuth();

  // Active Tab: "create" | "my-assignments" | "submissions" | "students" | "certifications"
  const [activeTab, setActiveTab] = useState("create");
  const [isMobileSidebarOpen, setIsMobileSidebarOpen] = useState(false);

  // Assignment Form State
  const [title, setTitle] = useState("");
  const [subject, setSubject] = useState("Web Development");
  const [description, setDescription] = useState("");
  const [dueDate, setDueDate] = useState("");
  const [dueTime, setDueTime] = useState("23:59");
  const [attachedFile, setAttachedFile] = useState(null); // { name, size, type, dataUrl }

  // Faculty Assignments & Submissions State
  const [myAssignments, setMyAssignments] = useState([]);
  const [selectedAssignmentForReview, setSelectedAssignmentForReview] = useState(null);
  const [assignmentSubmissions, setAssignmentSubmissions] = useState([]);

  // Course Students & Allocation State
  const [courseStudents, setCourseStudents] = useState([]);
  const [studentCourseFilter, setStudentCourseFilter] = useState("all");
  const [selectedStudentProfile, setSelectedStudentProfile] = useState(null);
  const [isLoadingStudents, setIsLoadingStudents] = useState(false);
  const [allocatingStudentId, setAllocatingStudentId] = useState(null);

  // Certifications State
  const [facultyCertificates, setFacultyCertificates] = useState([]);
  const [certCourseFilter, setCertCourseFilter] = useState("all");
  const [certStudents, setCertStudents] = useState([]);
  const [isLoadingCerts, setIsLoadingCerts] = useState(false);
  const [selectedStudentForCert, setSelectedStudentForCert] = useState(null);
  const [certTitleInput, setCertTitleInput] = useState("Certificate of Completion");
  const [certDateInput, setCertDateInput] = useState(() => new Date().toISOString().split("T")[0]);
  const [isIssuingCert, setIsIssuingCert] = useState(false);
  const [selectedCertForView, setSelectedCertForView] = useState(null);

  // UI state
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [feedbackMsg, setFeedbackMsg] = useState({ type: "", text: "" });
  const [isLoadingSubmissions, setIsLoadingSubmissions] = useState(false);

  // Active Meeting & Raise Hand Notification State
  const [activeMeeting, setActiveMeeting] = useState(null); // { roomId, peerName, peerRole }
  const [raiseHandNotification, setRaiseHandNotification] = useState(null);

  // Persistent 1-on-1 Messaging State for Faculty
  const [selectedChatStudent, setSelectedChatStudent] = useState(null);
  const [facultyChatMessages, setFacultyChatMessages] = useState([]);
  const [facultyChatInput, setFacultyChatInput] = useState("");
  const [isLoadingFacultyChat, setIsLoadingFacultyChat] = useState(false);
  const [isSendingFacultyChat, setIsSendingFacultyChat] = useState(false);

  // Global socket registration for faculty popup notifications
  useEffect(() => {
    if (!currentUser) return;
    const uid = currentUser.firebaseUid || currentUser.uid;
    const serverUrl = window.location.hostname === "localhost" ? "http://localhost:4000" : "/";
    const socket = io(serverUrl);

    socket.emit("register_user", { uid, role: "faculty" });

    socket.on("faculty_popup_notification", (data) => {
      console.log("[Faculty] Received popup notification:", data);
      setRaiseHandNotification(data);
    });

    return () => socket.disconnect();
  }, [currentUser]);

  // Load persistent chat history for selected student
  const loadFacultyChatHistory = useCallback(async (studentUid) => {
    if (!currentUser || !studentUid) return;
    setIsLoadingFacultyChat(true);
    try {
      const msgs = await getConversationHistory(currentUser, studentUid);
      setFacultyChatMessages(Array.isArray(msgs) ? msgs : []);
    } catch (err) {
      console.warn("Could not load faculty chat history:", err.message);
    } finally {
      setIsLoadingFacultyChat(false);
    }
  }, [currentUser]);

  useEffect(() => {
    if (selectedChatStudent?.firebaseUid) {
      loadFacultyChatHistory(selectedChatStudent.firebaseUid);
    }
  }, [selectedChatStudent, loadFacultyChatHistory]);

  // Real-time socket listener for faculty incoming messages
  useEffect(() => {
    if (!currentUser) return;
    const uid = currentUser.firebaseUid || currentUser.uid;
    const serverUrl = window.location.hostname === "localhost" ? "http://localhost:4000" : "/";
    const socket = io(serverUrl);
    socket.emit("register_user", { uid, role: "faculty" });

    socket.on("receive_private_message", (newMsg) => {
      setFacultyChatMessages((prev) => {
        if (prev.some((m) => (m._id && m._id === newMsg._id) || (m.createdAt && m.createdAt === newMsg.createdAt && m.message === newMsg.message))) {
          return prev;
        }
        return [...prev, newMsg];
      });
    });

    return () => socket.disconnect();
  }, [currentUser]);

  const handleSendFacultyMessage = async (e) => {
    e.preventDefault();
    if (!facultyChatInput.trim() || !selectedChatStudent?.firebaseUid || !currentUser) return;
    setIsSendingFacultyChat(true);
    try {
      const sentMsg = await sendPrivateMessage(
        currentUser,
        selectedChatStudent.firebaseUid,
        facultyChatInput.trim(),
        "faculty"
      );
      setFacultyChatMessages((prev) => [...prev, sentMsg]);
      setFacultyChatInput("");

      const serverUrl = window.location.hostname === "localhost" ? "http://localhost:4000" : "/";
      const socket = io(serverUrl);
      socket.emit("send_private_message", sentMsg);
      setTimeout(() => socket.disconnect(), 1000);
    } catch (err) {
      console.warn("Failed to send message:", err.message);
    } finally {
      setIsSendingFacultyChat(false);
    }
  };

  // Load faculty certificates & cert students
  const loadCertData = async (course = certCourseFilter) => {
    if (!currentUser) return;
    setIsLoadingCerts(true);
    try {
      const [certs, studs] = await Promise.all([
        getFacultyCertificates(currentUser, course),
        getRegisteredStudents(currentUser, course)
      ]);
      setFacultyCertificates(Array.isArray(certs) ? certs : []);
      setCertStudents(Array.isArray(studs) ? studs : []);
    } catch (err) {
      console.warn("Could not load certificates:", err.message);
    } finally {
      setIsLoadingCerts(false);
    }
  };

  const handleOpenIssueCertModal = (student) => {
    setSelectedStudentForCert(student);
    setCertTitleInput("Certificate of Completion");
    setCertDateInput(new Date().toISOString().split("T")[0]);
  };

  const handleConfirmIssueCert = async (e) => {
    e.preventDefault();
    if (!selectedStudentForCert || !currentUser) return;
    setIsIssuingCert(true);

    const payload = {
      studentUid: selectedStudentForCert.firebaseUid || selectedStudentForCert.uid,
      studentName: selectedStudentForCert.name || "Student",
      studentEmail: selectedStudentForCert.email || "",
      courseName: selectedStudentForCert.selectedCourse || "Web Development",
      certificateTitle: certTitleInput.trim() || "Certificate of Completion",
      issueDate: certDateInput
    };

    try {
      await issueCertificate(currentUser, payload);
      setFeedbackMsg({
        type: "success",
        text: `Certificate issued successfully to ${selectedStudentForCert.name}!`
      });
      setSelectedStudentForCert(null);
      await loadCertData(certCourseFilter);
    } catch (err) {
      setFeedbackMsg({
        type: "error",
        text: err.message || "Failed to issue certificate."
      });
    } finally {
      setIsIssuingCert(false);
      setTimeout(() => setFeedbackMsg({ type: "", text: "" }), 4000);
    }
  };

  const getStudentCertificate = (studentUid, courseName) => {
    return facultyCertificates.find(
      (c) => c.studentUid === studentUid && (!courseName || c.courseName === courseName)
    );
  };

  // Load students for faculty course allocation
  const loadStudents = async (course = "all") => {
    if (!currentUser) return;
    setIsLoadingStudents(true);
    try {
      const list = await getRegisteredStudents(currentUser, course);
      setCourseStudents(list);
    } catch (err) {
      console.warn("Could not load registered students:", err.message);
    } finally {
      setIsLoadingStudents(false);
    }
  };

  const handleAllocateStudentToMe = async (student) => {
    if (!currentUser) return;
    setAllocatingStudentId(student.firebaseUid);
    try {
      await allocateStudent(currentUser, student.firebaseUid);
      setFeedbackMsg({
        type: "success",
        text: `Student "${student.name}" allocated to you successfully!`
      });
      // Refresh students
      await loadStudents(studentCourseFilter);
      if (selectedStudentProfile && selectedStudentProfile.firebaseUid === student.firebaseUid) {
        setSelectedStudentProfile((prev) => ({
          ...prev,
          allocationStatus: "Assigned",
          allocatedFacultyId: currentUser.uid,
          allocatedFacultyName: currentUser.displayName || currentUser.email?.split("@")[0] || "Faculty Member"
        }));
      }
    } catch (err) {
      setFeedbackMsg({ type: "error", text: err.message || "Failed to allocate student." });
    } finally {
      setAllocatingStudentId(null);
      setTimeout(() => setFeedbackMsg({ type: "", text: "" }), 4000);
    }
  };

  const handleDownloadStudentResume = (student) => {
    if (student.resumeUrl && student.resumeUrl.startsWith("data:")) {
      const link = document.createElement("a");
      link.href = student.resumeUrl;
      link.download = student.resumeFileName || `${student.name.replace(/\s+/g, "_")}_Resume.pdf`;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    } else {
      const content = `V2V LMS - Student Profile & Resume Summary\n==============================================\nName: ${student.name}\nEmail: ${student.email}\nPhone: ${student.phone || "N/A"}\nCollege: ${student.college || "N/A"}\nSelected Course: ${student.selectedCourse || "N/A"}\nSubscription: ${student.subscriptionStatus || "N/A"}\nAllocation: ${student.allocationStatus || "Pending"}\n\nLinkedIn: ${student.linkedin || "Not provided"}\nGitHub: ${student.github || "Not provided"}`;
      const blob = new Blob([content], { type: "text/plain" });
      const link = document.createElement("a");
      link.href = URL.createObjectURL(blob);
      link.download = `${student.name.replace(/\s+/g, "_")}_Profile.txt`;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }
  };


  // Load faculty assignments on mount
  const loadFacultyAssignments = useCallback(async () => {
    if (!currentUser) return;
    try {
      const list = await getMyFacultyAssignments(currentUser);
      setMyAssignments(list);
      if (list.length > 0 && !selectedAssignmentForReview) {
        setSelectedAssignmentForReview(list[0]);
      }
    } catch (error) {
      setFeedbackMsg({ type: "error", text: error.message || "Could not load your assignments." });
    }
  }, [currentUser, selectedAssignmentForReview]);

  useEffect(() => {
    // eslint-disable-next-line react-hooks/set-state-in-effect
    loadFacultyAssignments();
  }, [loadFacultyAssignments]);

  const loadSubmissionsForAssignment = useCallback(async (assignmentId) => {
    if (!assignmentId || !currentUser) return;
    setIsLoadingSubmissions(true);
    try {
      const list = await getAssignmentSubmissions(currentUser, assignmentId);
      setAssignmentSubmissions(list);
    } catch {
      setAssignmentSubmissions([]);
    } finally {
      setIsLoadingSubmissions(false);
    }
  }, [currentUser]);

  // Load submissions when selected assignment changes
  useEffect(() => {
    if (selectedAssignmentForReview && currentUser) {
