const apiBaseUrl = import.meta.env.VITE_API_URL || "http://localhost:4000";

async function readResponse(response, fallbackMessage) {
  try {
    const contentType = response.headers.get("content-type") || "";
    const data = contentType.includes("application/json")
      ? await response.json()
      : { error: await response.text() };

    if (!response.ok) {
      const message = data.error || data.message || fallbackMessage;
      throw new Error(`${message} (HTTP ${response.status})`);
    }

    return data;
  } catch (err) {
    if (err.name === "TypeError" && err.message.includes("Failed to fetch")) {
      throw new Error("Unable to connect to LMS backend server at http://localhost:4000. Please check your connection.");
    }
    throw err;
  }
}

async function authHeader(user) {
  if (!user) {
    throw new Error("A signed-in Firebase user is required");
  }
  const token = await user.getIdToken();
  return {
    Authorization: `Bearer ${token}`,
    "Content-Type": "application/json"
  };
}

export async function getMyProfile(user) {
  const headers = await authHeader(user);
  const response = await fetch(`${apiBaseUrl}/api/users/me`, { headers });
  return readResponse(response, "Could not load your application profile");
}

