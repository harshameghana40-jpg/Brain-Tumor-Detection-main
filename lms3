  const handleSignOut = async () => {
    await logout();
    if (onLogout) {
      onLogout();
    }
  };

  // Handle file selection and conversion to data URL
  const handleFileChange = (e) => {
    const file = e.target.files?.[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = () => {
      setAttachedFile({
        name: file.name,
        size: (file.size / (1024 * 1024)).toFixed(2) + " MB",
        type: file.type || "application/octet-stream",
        dataUrl: reader.result
      });
    };
    reader.readAsDataURL(file);
  };

  // Submit Assignment Creation
  const handleCreateAssignment = async (e) => {
    e.preventDefault();
    setFeedbackMsg({ type: "", text: "" });

    if (!title.trim() || !description.trim() || !dueDate) {
      setFeedbackMsg({ type: "error", text: "Please enter Assignment Title, Description, and Due Date." });
      return;
    }

    setIsSubmitting(true);

    const assignmentData = {
      title: title.trim(),
      subject: subject.trim(),
      description: description.trim(),
      dueDate,
      dueTime: dueTime || "11:59 PM",
      attachedFileName: attachedFile ? attachedFile.name : null,
      attachedFileSize: attachedFile ? attachedFile.size : null,
      attachedFileType: attachedFile ? attachedFile.type : null,
      fileUrl: attachedFile ? attachedFile.dataUrl : null
    };

    try {
      const response = await createAssignment(currentUser, assignmentData);
      const createdItem = response.assignment;

      setMyAssignments((prev) => [createdItem, ...prev]);
      setFeedbackMsg({ type: "success", text: "Assignment successfully created and published to students!" });

      // Reset form
      setTitle("");
      setDescription("");
      setDueDate("");
      setAttachedFile(null);
      setTimeout(() => {
        setFeedbackMsg({ type: "", text: "" });
        setActiveTab("my-assignments");
      }, 1500);
    } catch (err) {
      setFeedbackMsg({ type: "error", text: err.message || "Failed to create assignment." });
    } finally {
      setIsSubmitting(false);
    }
  };

  // Delete Assignment
  const handleDeleteAssignment = async (id) => {
    if (!window.confirm("Are you sure you want to delete this assignment and all associated submissions?")) {
      return;
    }

    try {
      await deleteAssignment(currentUser, id);
    } catch {
      // Allow local state update regardless
    }

    setMyAssignments((prev) => prev.filter((item) => (item._id || item.id) !== id));
    if (selectedAssignmentForReview && (selectedAssignmentForReview._id || selectedAssignmentForReview.id) === id) {
      setSelectedAssignmentForReview(null);
      setAssignmentSubmissions([]);
    }
  };

  // Download Student Work
  const handleDownloadStudentWork = (sub) => {
    if (sub.fileUrl && sub.fileUrl.startsWith("data:")) {
      const link = document.createElement("a");
      link.href = sub.fileUrl;
      link.download = sub.fileName || "student_submission.pdf";
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    } else {
      const content = `V2V LMS - Student Submission\n=================================\nStudent: ${sub.studentName} (${sub.studentEmail})\nAssignment ID: ${sub.assignmentId}\nSubmitted Timestamp: ${new Date(sub.submittedAt).toLocaleString()}\nFile: ${sub.fileName}\n\nStudent Notes:\n${sub.notes || "No additional comments"}`;
      const blob = new Blob([content], { type: "text/plain" });
      const link = document.createElement("a");
      link.href = URL.createObjectURL(blob);
      link.download = (sub.fileName || "submission").replace(/\.[^/.]+$/, "") + "_review.txt";
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
