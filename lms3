import { Router } from "express";
import { getDatabase } from "../config/database.js";
import { authenticate } from "../middleware/authenticate.js";

const router = Router();

function getConversationId(uid1, uid2) {
  return [uid1, uid2].sort().join("_");
}

// -------------------------------------------------------------
// GET CONVERSATION HISTORY BETWEEN LOGGED IN USER & PARTNER
// -------------------------------------------------------------
router.get("/history/:partnerUid", authenticate, async (req, res, next) => {
  try {
    const senderUid = req.firebaseUser.uid;
    const { partnerUid } = req.params;

    if (!partnerUid) {
      return res.status(400).json({ error: "partnerUid parameter is required" });
    }

    const conversationId = getConversationId(senderUid, partnerUid);
    const db = getDatabase();
    const messagesCollection = db.collection("one_on_one_messages");

    const history = await messagesCollection
      .find({ conversationId })
      .sort({ createdAt: 1 })
      .limit(500)
      .toArray();

    return res.json(history || []);
  } catch (error) {
    next(error);
  }
});

// -------------------------------------------------------------
// SEND A PRIVATE MESSAGE (PERSISTED TO MONGODB)
// -------------------------------------------------------------
router.post("/send", authenticate, async (req, res, next) => {
  try {
    const senderUid = req.firebaseUser.uid;
    const senderName = req.firebaseUser.name || req.firebaseUser.email?.split("@")[0] || "User";
    const { recipientUid, message, senderRole } = req.body;

    if (!recipientUid || !message?.trim()) {
      return res.status(400).json({ error: "recipientUid and non-empty message are required" });
    }

    const conversationId = getConversationId(senderUid, recipientUid);
    const db = getDatabase();
    const messagesCollection = db.collection("one_on_one_messages");
    const now = new Date();

    const newMsgDoc = {
      conversationId,
      senderUid,
      senderName,
      senderRole: senderRole || "user",
      recipientUid,
      message: message.trim(),
      createdAt: now
    };

    const result = await messagesCollection.insertOne(newMsgDoc);
    const insertedMsg = { ...newMsgDoc, _id: result.insertedId };

    return res.json(insertedMsg);
  } catch (error) {
    next(error);
  }
});

// -------------------------------------------------------------
// GET CONVERSATION PARTNERS FOR FACULTY / STUDENT
// -------------------------------------------------------------
router.get("/conversations", authenticate, async (req, res, next) => {
  try {
    const userUid = req.firebaseUser.uid;
    const db = getDatabase();
    const messagesCollection = db.collection("one_on_one_messages");
    const usersCollection = db.collection("user_details");

    // Find all distinct conversation partners where current user is sender or recipient
    const msgs = await messagesCollection
      .find({
        $or: [{ senderUid: userUid }, { recipientUid: userUid }]
      })
      .sort({ createdAt: -1 })
      .toArray();

    const partnerUids = new Set();
    const latestMessages = new Map();

    msgs.forEach((m) => {
      const partner = m.senderUid === userUid ? m.recipientUid : m.senderUid;
      if (!partnerUids.has(partner)) {
        partnerUids.add(partner);
        latestMessages.set(partner, m);
      }
    });

    const partnerProfiles = await usersCollection
      .find({ firebaseUid: { $in: Array.from(partnerUids) } })
      .toArray();

    const conversations = partnerProfiles.map((p) => ({
      uid: p.firebaseUid,
      name: p.name || p.email?.split("@")[0] || "User",
      email: p.email,
      role: p.role,
      course: p.selectedCourse || "General",
      lastMessage: latestMessages.get(p.firebaseUid)?.message || "",
      lastTimestamp: latestMessages.get(p.firebaseUid)?.createdAt || null
    }));

    return res.json(conversations);
  } catch (error) {
    next(error);
  }
});

