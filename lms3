                        </div>

                        {/* MESSAGES LIST */}
                        <div style={{ flex: 1, padding: "16px", overflowY: "auto", display: "flex", flexDirection: "column", gap: "12px" }}>
                            {messages.length === 0 ? (
                                <div style={{ textAlign: "center", color: "#64748b", marginTop: "40px", fontSize: "13px" }}>
                                    💬 No messages yet. Send a message to start private interaction!
                                </div>
                            ) : (
                                messages.map((m) => {
                                    const isMe = m.senderId === (currentUser?.firebaseUid || currentUser?.uid);
                                    return (
                                        <div
                                            key={m.id}
                                            style={{
                                                alignSelf: isMe ? "flex-end" : "flex-start",
                                                maxWidth: "85%"
                                            }}
                                        >
                                            <div
                                                style={{
                                                    fontSize: "11px",
                                                    color: "#94a3b8",
                                                    marginBottom: "4px",
                                                    textAlign: isMe ? "right" : "left"
                                                }}
                                            >
                                                {m.senderName} ({m.senderRole}) • {m.timestamp}
                                            </div>
                                            <div
                                                style={{
                                                    backgroundColor: isMe ? "#4f46e5" : "#334155",
                                                    color: "#ffffff",
                                                    padding: "10px 14px",
                                                    borderRadius: isMe ? "14px 14px 2px 14px" : "14px 14px 14px 2px",
                                                    fontSize: "13px",
                                                    lineHeight: "1.4",
                                                    wordBreak: "break-word",
                                                    boxShadow: "0 2px 8px rgba(0,0,0,0.2)"
                                                }}
                                            >
                                                {m.message}
                                            </div>
                                        </div>
                                    );
                                })
                            )}
                            <div ref={chatBottomRef} />
                        </div>

                        {/* CHAT INPUT FORM */}
                        <form
                            onSubmit={handleSendChat}
                            style={{
                                padding: "14px",
                                borderTop: "1px solid rgba(255, 255, 255, 0.1)",
                                display: "flex",
                                gap: "8px"
                            }}
                        >
                            <input
                                type="text"
                                placeholder="Type private message..."
                                value={inputMsg}
                                onChange={(e) => setInputMsg(e.target.value)}
                                style={{
                                    flex: 1,
                                    backgroundColor: "#0f172a",
                                    border: "1px solid #334155",
                                    borderRadius: "8px",
                                    padding: "10px 14px",
                                    color: "#ffffff",
                                    fontSize: "13px",
                                    outline: "none"
                                }}
                            />
                            <button
                                type="submit"
                                style={{
                                    backgroundColor: "#4f46e5",
                                    border: "none",
                                    borderRadius: "8px",
                                    padding: "10px 14px",
                                    color: "#ffffff",
                                    cursor: "pointer"
                                }}
                            >
                                <Send size={16} />
                            </button>
                        </form>
                    </div>
                )}
            </div>

            {/* FLOATING ZOOM / GOOGLE MEET STYLE CONTROL BAR */}
            <footer
                style={{
                    height: "80px",
                    backgroundColor: "#0f172a",
                    borderTop: "1px solid rgba(255, 255, 255, 0.1)",
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "center",
                    gap: "16px",
                    padding: "0 24px"
                }}
            >
                {/* MIC MUTE TOGGLE */}
                <button
                    onClick={toggleAudio}
                    style={{
                        width: "50px",
                        height: "50px",
                        borderRadius: "50%",
                        backgroundColor: audioMuted ? "#ef4444" : "#334155",
                        border: "none",
                        color: "#ffffff",
                        display: "flex",
                        alignItems: "center",
                        justifyContent: "center",
                        cursor: "pointer",
                        transition: "all 0.2s"
                    }}
                    title={audioMuted ? "Unmute Mic" : "Mute Mic"}
                >
                    {audioMuted ? <MicOff size={22} /> : <Mic size={22} />}
                </button>

                {/* CAMERA TOGGLE */}
                <button
                    onClick={toggleVideo}
                    style={{
                        width: "50px",
                        height: "50px",
                        borderRadius: "50%",
                        backgroundColor: videoOff ? "#ef4444" : "#334155",
                        border: "none",
                        color: "#ffffff",
                        display: "flex",
                        alignItems: "center",
                        justifyContent: "center",
                        cursor: "pointer",
                        transition: "all 0.2s"
                    }}
                    title={videoOff ? "Turn On Camera" : "Turn Off Camera"}
                >
                    {videoOff ? <VideoOff size={22} /> : <VideoIcon size={22} />}
                </button>

                {/* SCREEN SHARE TOGGLE */}
                <button
                    onClick={toggleScreenShare}
                    style={{
                        width: "50px",
                        height: "50px",
                        borderRadius: "50%",
                        backgroundColor: isScreenSharing ? "#22c55e" : "#334155",
                        border: "none",
                        color: "#ffffff",
                        display: "flex",
                        alignItems: "center",
                        justifyContent: "center",
                        cursor: "pointer",
                        transition: "all 0.2s"
                    }}
                    title={isScreenSharing ? "Stop Screen Share" : "Share Screen"}
                >
                    <Monitor size={22} />
                </button>

                {/* STUDENT RAISE HAND BUTTON */}
                {userRole === "student" && (
                    <button
                        onClick={handleToggleRaiseHand}
                        style={{
                            width: "50px",
                            height: "50px",
                            borderRadius: "50%",
                            backgroundColor: isHandRaised ? "#f59e0b" : "#334155",
                            border: "none",
                            color: "#ffffff",
                            display: "flex",
                            alignItems: "center",
                            justifyContent: "center",
                            cursor: "pointer",
                            transition: "all 0.2s",
                            boxShadow: isHandRaised ? "0 0 15px rgba(245, 158, 11, 0.7)" : "none"
                        }}
                        title={isHandRaised ? "Lower Hand" : "Raise Hand"}
                    >
                        <Hand size={22} />
                    </button>
                )}

                {/* PRIVATE CHAT TOGGLE BUTTON */}
                <button
                    onClick={() => {
                        setShowChat(!showChat);
                        if (!showChat) setUnreadCount(0);
                    }}
                    style={{
                        width: "50px",
                        height: "50px",
                        borderRadius: "50%",
                        backgroundColor: showChat ? "#6366f1" : "#334155",
                        border: "none",
                        color: "#ffffff",
                        display: "flex",
                        alignItems: "center",
                        justifyContent: "center",
                        cursor: "pointer",
                        position: "relative",
                        transition: "all 0.2s"
                    }}
                    title="Toggle Private Chat"
                >
                    <MessageSquare size={22} />
                    {unreadCount > 0 && (
                        <span
                            style={{
                                position: "absolute",
