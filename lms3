                <polyline points="14 2 14 8 20 8" />
                <line x1="16" y1="13" x2="8" y2="13" />
                <line x1="16" y1="17" x2="8" y2="17" />
              </svg>
              <span>Review Submissions</span>
            </button>

            <button
              type="button"
              className={`faculty-nav-item ${activeTab === "students" ? "active" : ""}`}
