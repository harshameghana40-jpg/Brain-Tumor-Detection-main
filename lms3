                setActiveTab("students");
                loadStudents(studentCourseFilter);
                setIsMobileSidebarOpen(false);
              }}
              id="tab-course-students"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
              </svg>
              <span>Course Students</span>
            </button>

            <button
              type="button"
              className={`faculty-nav-item ${activeTab === "certifications" ? "active" : ""}`}
              onClick={() => {
                setActiveTab("certifications");
                loadCertData(certCourseFilter);
                setIsMobileSidebarOpen(false);
              }}
              id="tab-certifications"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2">
                <path d="M12 15l-2 5l5-3l5 3l-2-5" />
                <circle cx="12" cy="9" r="6" />
              </svg>
              <span>Certifications</span>
              {facultyCertificates.length > 0 && <span className="faculty-nav-badge">{facultyCertificates.length}</span>}
            </button>

            <button
              type="button"
              className={`faculty-nav-item ${activeTab === "interaction" ? "active" : ""}`}
              onClick={() => {
                setActiveTab("interaction");
                loadStudents(studentCourseFilter);
                setIsMobileSidebarOpen(false);
              }}
              id="tab-interaction"
            >
