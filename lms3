                            }}
                        />

                        {/* Remote Placeholder when not connected or camera off */}
                        {!peerConnected && (
                            <div style={{ textAlign: "center", padding: "20px" }}>
                                <div
                                    style={{
                                        width: "100px",
                                        height: "100px",
                                        borderRadius: "50%",
                                        backgroundColor: "#334155",
                                        color: "#818cf8",
                                        display: "flex",
                                        alignItems: "center",
                                        justifyContent: "center",
                                        fontSize: "36px",
                                        fontWeight: "bold",
                                        margin: "0 auto 16px auto",
                                        border: "3px solid #6366f1",
